{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Path aliases (keep in sync with vite.config.ts) */
    "paths": {
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@platform": ["./src/platform/index.ts"],
      "@platform/*": ["./src/platform/*"],
      "@shared/core": ["./src/shared/core/index.ts"],
      "@shared/agent-server": ["./src/shared/agent-server/index.ts"],
      "@shared/collaborators": ["./src/shared/collaborators/index.ts"],
      "@shared/*": ["./src/shared/*"],
      "@canvas": ["./src/canvas/index.ts"],
      "@canvas/*": ["./src/canvas/*"],
      "@canvas-ui": ["./src/canvas-ui/index.ts"],
      "@canvas-ui/*": ["./src/canvas-ui/*"],
      "@board": ["./src/products/board/index.ts"],
      "@board/*": ["./src/products/board/*"],
      "@design": ["./src/products/design/index.ts"],
      "@design/*": ["./src/products/design/*"]
    }
  },
  "include": ["src"]
}

# Release signing for Android. Copy this file to keystore.properties (gitignored) in this folder
# and fill it in; without it, `pnpm release:android` makes an unsigned APK.
# Keep the keystore outside the repo and back it up: losing it means no updates to installed apps.

# Absolute path to the keystore (.jks), made with Android Studio (Build > Generate Signed App
# Bundle or APK > Create new) or with keytool.
storeFile=/path/to/cloudy-canvas.jks
# The keystore's password.
storePassword=
# The key's name inside the keystore (Android Studio's default is key0).
keyAlias=key0
# The key's password (often the same as storePassword).
keyPassword=

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudy Canvas",
  "version": "0.1.0",
  "identifier": "com.darkredgm.cloudycanvas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloudy Canvas",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cloudy-canvas"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["cboard"],
        "name": "Cloudy Canvas board",
        "description": "Cloudy Canvas board",
        "mimeType": "application/x-cloudy-canvas-board",
        "role": "Editor"
      },
      {
        "ext": ["cdesign"],
        "name": "Cloudy Canvas design",
        "description": "Cloudy Canvas design",
        "mimeType": "application/x-cloudy-canvas-design",
        "role": "Editor"
      }
    ]
  }
}

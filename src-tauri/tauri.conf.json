{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudy Canvas",
  "version": "0.3.0",
  "identifier": "com.darkredgm.cloudycanvas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloudy Canvas",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cloudy-canvas"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDOURDRkQ3NUQ4RjREODMKUldTRFRZOWQxOCtkL0drbG5pZmxhcFhpU2lVdXhaUXJyWHJCQ0lGM283VnhDcjVtUzRQWENhcUoK",
      "endpoints": [
        "https://github.com/Cloudy-Studio-Apps/cloudy-canvas/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["cboard"],
        "name": "Cloudy Canvas board",
        "description": "Cloudy Canvas board",
        "mimeType": "application/x-cloudy-canvas-board",
        "role": "Editor",
        "contentTypes": ["com.darkredgm.cloudycanvas.board"],
        "exportedType": {
          "identifier": "com.darkredgm.cloudycanvas.board",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["cdesign"],
        "name": "Cloudy Canvas design",
        "description": "Cloudy Canvas design",
        "mimeType": "application/x-cloudy-canvas-design",
        "role": "Editor",
        "contentTypes": ["com.darkredgm.cloudycanvas.design"],
        "exportedType": {
          "identifier": "com.darkredgm.cloudycanvas.design",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  }
}
